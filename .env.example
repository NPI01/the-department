# ---- Cobble Network inference (OpenAI-compatible) ----
COBBLE_API_KEY=
COBBLE_BASE_URL=https://api.cobble.network/v1
# Model chain, first available wins. 27B is the intended agent; the others are fallbacks.
COBBLE_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-35b-a3b,qwen/qwen3.8-flash-next
# 1 = let the model think (slower, better for rules/canon work); 0 = off
COBBLE_THINKING=0

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend ----
RESEND_API_KEY=
# Verified sending domain for the game. Must also have Receiving enabled (MX → Resend).
EMAIL_DOMAIN=weird.delivery
EMAIL_FROM="The Department <thedepartment@weird.delivery>"
# Signing secret of the inbound webhook (whsec_...)
RESEND_WEBHOOK_SECRET=

# ---- Engine ----
# Shared secret the Vercel cron sends as Authorization: Bearer
CRON_SECRET=
# Site URL for links in mail
NEXT_PUBLIC_SITE_URL=http://localhost:3000
